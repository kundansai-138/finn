# Local development: `docker compose up -d db` provides this database.
DATABASE_URL=postgresql+psycopg://finn_app:finn_app_local@localhost:5432/finn
TEST_DATABASE_URL=postgresql+psycopg://finn_app:finn_app_local@localhost:5432/finn_test

# Optional. Visitors can connect their own model in the app (any provider, their key, kept on their
# device). A server key below is the fallback for visitors who skip that, and for scheduled jobs.
# Without any key FINN runs on deterministic fallbacks. Demo-set cost with a key: < $1.
ANTHROPIC_API_KEY=
# Or Gemini (Google AI Studio key). With only this set, FINN uses Gemini automatically.
GEMINI_API_KEY=
# Or any provider: anthropic | gemini | openai | openrouter | groq | deepseek | mistral | together | custom
# FINN_LLM_PROVIDER=openai
# FINN_LLM_API_KEY=
# FINN_LLM_BASE_URL=            # only for "custom" (an OpenAI-compatible https endpoint)
# FINN_LLM_BYOK=off             # don't let visitors bring their own key

# Model routing (defaults shown)
# FINN_MODEL_FAST=claude-haiku-5-5
# FINN_MODEL_DEEP=claude-opus-5-5
# FINN_MODEL_WEB=claude-sonnet-5-5

# Production only (see docs/DESIGN.md#7-deployment)
# FINN_ADMIN_TOKEN=            # guards POST /api/refresh
# FINN_VAPID_PRIVATE_KEY=      # python -m scripts.vapid_keys
# FINN_VAPID_PUBLIC_KEY=
# FINN_VAPID_SUBJECT=mailto:you@example.com

# Accounts
# FINN_AUTH_STRICT=on          # production: identity only from the session cookie (no X-FINN-User header)
# FINN_TEST_USER= / FINN_TEST_PASSWORD=   written here by `python -m scripts.create_user <name>`

# Demo controls
# FINN_SCENARIOS=on            # the three Simulated events (badged in the UI)
# FINN_NOW=2026-11-14T08:30:00+05:30
